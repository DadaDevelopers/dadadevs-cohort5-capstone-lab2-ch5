PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
BITCOIN_RPC_URL=http://127.0.0.1:18444
# Prefer the Bitcoin Core Regtest cookie. Use user/password only when cookie auth is unavailable.
BITCOIN_RPC_COOKIE_FILE=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_TIMEOUT_MS=10000
# Development-only signer utility settings. Set COMMUNITYSAFE_TOKEN per signer session.
COMMUNITYSAFE_API_URL=http://127.0.0.1:3000
COMMUNITYSAFE_SIGNER_REGISTRY=
