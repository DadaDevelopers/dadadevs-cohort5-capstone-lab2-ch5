PORT=3000
NODE_ENV=development
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
# Use the exact number of trusted reverse proxies in front of Express (for example 1 on a single-proxy host).
TRUST_PROXY=
# Optional overrides. Leave blank to use the safe defaults selected by NODE_ENV.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_REFRESH_MAX=
RATE_LIMIT_SESSION_MAX=
RATE_LIMIT_COMMUNITY_MAX=
RATE_LIMIT_FINANCIAL_MAX=
RATE_LIMIT_DISCUSSION_MAX=
LOGIN_FAILED_ATTEMPT_LIMIT=
LOGIN_LOCKOUT_MS=
BITCOIN_RPC_URL=http://127.0.0.1:18444
# Prefer the Bitcoin Core Regtest cookie. Use user/password only when cookie auth is unavailable.
BITCOIN_RPC_COOKIE_FILE=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_TIMEOUT_MS=10000
# Development-only signer utility settings. Set COMMUNITYSAFE_TOKEN per signer session.
COMMUNITYSAFE_API_URL=http://127.0.0.1:3000
COMMUNITYSAFE_SIGNER_REGISTRY=
