# Base URL of the CommunitySafe backend, with no trailing slash.
# Leave empty for local development so requests go through the Vite proxy to localhost:3000.
# On Render, set it to the backend service URL, for example https://communitysafe-backend.onrender.com
VITE_API_BASE_URL=

# Set to "true" to enable the experimental in-browser signer (Regtest only).
VITE_ENABLE_BROWSER_SIGNER=
